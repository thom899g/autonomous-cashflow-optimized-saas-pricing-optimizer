{
  "version": 1,
  "handlers": {
    "file_handler": {
      "class": "logging.FileHandler",
      "filename": "/var/log/app.log",
      "level": "INFO",
      "formatter": "default"
    },
    "console_handler": {
      "class": "logging.StreamHandler",
      "level": "DEBUG",
      "formatter": "default"
    }
  },
  "formatters": {
    "default": {
      "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": ["file_handler", "console_handler"],
    "qualname": "pricing_optimizer.monitoring_service"
  }
}